{
  "name": "pilltracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend:dev": "nodemon backend/src/server.js",
    "backend:start": "node backend/src/server.js",
    "frontend:dev": "vite frontend --host 0.0.0.0 --port 5173",
    "frontend:build": "vite build frontend",
    "frontend:preview": "vite preview frontend --host 0.0.0.0 --port 4173",
    "dev": "concurrently -k -n backend,frontend -c auto \"npm run backend:dev\" \"npm run frontend:dev\"",
    "start": "npm run backend:start",
    "compose:up": "docker compose up -d app",
    "compose:up:build": "docker compose up -d --build app",
    "compose:install": "docker compose run --rm app npm install",
    "compose:down": "docker compose down --remove-orphans",
    "compose:reset": "docker compose down --volumes --remove-orphans",
    "compose:logs": "docker compose logs -f app",
    "test:backend:smoke": "node backend/tests/smoke/health.mjs",
    "test:backend:smoke:compose": "docker compose up -d app && npm run test:backend:smoke",
    "test:frontend:build": "npm run frontend:build",
    "repo:format": "prettier . --write",
    "repo:format:check": "prettier . --check",
    "repo:lint": "eslint backend frontend scripts eslint.config.js",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "fix": "node scripts/fix.mjs",
    "precommit": "node scripts/pre-commit.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.9",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
